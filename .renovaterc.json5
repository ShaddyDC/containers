{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-config"],
  // No Helm charts here; these post-upgrade tasks aren't allowed on hosted Renovate
  ignorePresets: ["github>home-operations/renovate-config:helmPostUpgradeTasks.json5"],
  minimumReleaseAge: "7 days",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
  },
  packageRules: [
    {
      // Supply-chain cooldown. The home-operations preset sets 3 days for
      // package registries in a packageRule, which beats the top-level
      // setting, so it is restated here. Docker images outside Docker Hub
      // carry no release timestamps and still update without waiting.
      matchPackageNames: ["*"],
      minimumReleaseAge: "7 days",
    },
    {
      matchUpdateTypes: ["digest"],
      automerge: true,
    },
    {
      matchManagers: ["pep621"],
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update _VERSION variables in Dockerfiles",
      managerFilePatterns: [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s",
      ],
    },
  ],
}
